# Configuració del servidor de PagePlus Web (server.js)
# Les variables d'entorn del sistema tenen prioritat sobre aquest fitxer.

# Port on escolta el servidor
PORT=8080

# Adreça on escolta: 127.0.0.1 = només aquest ordinador · 0.0.0.0 = també tauletes i mòbils de la xarxa local
HOST=127.0.0.1

# Carpeta on es desen les publicacions (relativa a la carpeta de l'aplicació o absoluta; ~ = carpeta d'usuari)
# Exemples: DATA_DIR=data · DATA_DIR=~/Documents/PagePlus · DATA_DIR=D:/Publicacions
DATA_DIR=data

# Mida màxima d'una publicació en MB (les imatges van incrustades)
MAX_UPLOAD_MB=50
